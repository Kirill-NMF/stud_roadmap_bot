# Copy to /etc/zoom-audio-pipeline/pipeline.env on the VPS.
# Do not commit real values.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=

# Default cloud Bot API cannot download files above 20 MiB through getFile.
# For large Telegram uploads, run Local Bot API Server and set:
# TELEGRAM_API_BASE_URL=http://127.0.0.1:8081
# TELEGRAM_LOCAL_API_ID and TELEGRAM_LOCAL_API_HASH are app credentials from my.telegram.org.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_CLOUD_MAX_DOWNLOAD_MB=20
LOCAL_BOT_API_ROOT=/var/lib/telegram-bot-api
TELEGRAM_LOCAL_API_ID=
TELEGRAM_LOCAL_API_HASH=
TELEGRAM_LOCAL_API_PORT=8081

NOTION_API_KEY=
NOTION_TARGET=

OPENROUTER_API_KEY=

# Public URL where Caddy serves generated pages.
# Example: https://roadmap.example.com/roadmap-reader
ROADMAP_PUBLIC_BASE_URL=
ROADMAP_PUBLIC_ROOT=/var/www/roadmap-reader

OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_ROADMAP_MODEL=openai/gpt-5.5
OPENROUTER_ARTICLE_MODEL=openai/gpt-5.5
OPENROUTER_VERIFICATION_MODEL=openai/gpt-5.5
GEMINI_REWRITE_MODEL=google/gemini-2.5-pro

PIPELINE_PYTHON=python3
TRANSCRIPTION_PROVIDER=openrouter
TELEGRAM_VOICE_TRANSCRIPTION_PROVIDER=openrouter
TELEGRAM_VOICE_TRANSCRIBE_TIMEOUT=900
OPENROUTER_STT_RETRIES=3
OPENROUTER_STT_RETRY_DELAY=3
OPENROUTER_STT_COMPRESS_THRESHOLD_MB=20
OPENROUTER_STT_FALLBACK=local

VERIFICATION_SCRIPT=/usr/local/bin/generate-verification-with-openrouter
ARTICLE_SCRIPT=/usr/local/bin/generate-article-with-gemini-rewrite
ARTICLE_DRAFT_SCRIPT=/usr/local/bin/generate-article-with-openrouter
GEMINI_REWRITE_TIMEOUT_SECONDS=1200
